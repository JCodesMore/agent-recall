{
  "name": "@jcodesmore/agent-recall",
  "version": "1.0.0",
  "description": "Let your AI agents find and read any past conversation from Claude Code, Codex, OpenCode and Cursor.",
  "type": "module",
  "private": true,
  "bin": {
    "agent-recall": "./scripts/recall.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "recall": "node ./scripts/recall.mjs",
    "sync": "node ./scripts/recall.mjs sync",
    "doctor": "node ./scripts/recall.mjs doctor",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "eval": "node --disable-warning=ExperimentalWarning ./test/eval/run.mjs",
    "eval:local": "node --disable-warning=ExperimentalWarning ./test/eval/local.mjs",
    "check": "npm test && npm run eval"
  },
  "files": [
    ".claude-plugin",
    "SKILL.md",
    "agents",
    "references",
    "hooks",
    "scripts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/JCodesMore/agent-recall",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/agent-recall.git"
  },
  "keywords": [
    "agent-skills",
    "agent-recall",
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "conversation-search",
    "session-history",
    "local-first"
  ],
  "license": "Apache-2.0"
}
