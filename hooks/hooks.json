{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/recall.mjs",
              "sync",
              "--quiet"
            ],
            "async": true,
            "timeout": 600
          }
        ]
      }
    ]
  }
}
